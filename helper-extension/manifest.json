{
  "manifest_version": 3,
  "name": "IRTool Network Attribution Helper",
  "version": "1.0.0",
  "description": "Attribution helper for IRTool browser forensics",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["webRequest", "management", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js"
  }
}
